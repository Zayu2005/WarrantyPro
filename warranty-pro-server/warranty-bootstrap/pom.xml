<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.warrantypro</groupId>
        <artifactId>warranty-pro-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>warranty-bootstrap</artifactId>
    <name>warranty-bootstrap</name>
    <description>启动装配与全局配置：聚合全部业务模块，Spring Boot 可执行 JAR</description>

    <dependencies>
        <dependency>
            <groupId>com.warrantypro</groupId>
            <artifactId>warranty-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.warrantypro</groupId>
            <artifactId>warranty-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.warrantypro</groupId>
            <artifactId>warranty-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.warrantypro</groupId>
            <artifactId>warranty-estate</artifactId>
        </dependency>
        <dependency>
            <groupId>com.warrantypro</groupId>
            <artifactId>warranty-warranty</artifactId>
        </dependency>
        <dependency>
            <groupId>com.warrantypro</groupId>
            <artifactId>warranty-order</artifactId>
        </dependency>
        <dependency>
            <groupId>com.warrantypro</groupId>
            <artifactId>warranty-dispatch</artifactId>
        </dependency>
        <dependency>
            <groupId>com.warrantypro</groupId>
            <artifactId>warranty-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.warrantypro</groupId>
            <artifactId>warranty-notify</artifactId>
        </dependency>
        <dependency>
            <groupId>com.warrantypro</groupId>
            <artifactId>warranty-stat</artifactId>
        </dependency>
        <dependency>
            <groupId>com.warrantypro</groupId>
            <artifactId>warranty-file</artifactId>
        </dependency>

        <!-- Web 与基础设施（实现阶段逐步扩充，见 docs/04 §3） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>warranty-bootstrap</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
